<Project>
  <PropertyGroup>
    <RepoRootDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</RepoRootDir>
    <CommonPackagesDir>$(RepoRootDir)artifacts\packages\</CommonPackagesDir>
    <NpOnPackageVersion>2.0.0</NpOnPackageVersion>
    <Version>$(NpOnPackageVersion)</Version>
    <PackageVersion>$(NpOnPackageVersion)</PackageVersion>
    <DebugType Condition="'$(DebugType)' == ''">embedded</DebugType>
  </PropertyGroup>
</Project>
