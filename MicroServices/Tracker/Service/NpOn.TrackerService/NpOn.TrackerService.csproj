<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MicroServices.Tracker.Service.NpOn.TrackerService</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.AspNetCore"/>
        <PackageReference Include="NpOn.AddGrpcAppExtUse" />
        <PackageReference Include="NpOn.RedisAppExtUse" />
        <PackageReference Include="NpOn.ZeroMqAppExtUse" />
        <PackageReference Include="NpOn.CommonHttpApplication" />
        <PackageReference Include="NpOn.CommonEnums" />
        <PackageReference Include="NpOn.CommonGrpcCall" />
        <PackageReference Include="NpOn.CommonHeaderConfig" />
        <PackageReference Include="NpOn.CommonMode" />
        <PackageReference Include="NpOn.ClickHouseAppExtUse" />
        <PackageReference Include="NpOn.Account.Proto" />
        <PackageReference Include="NpOn.General.Proto" />
        <PackageReference Include="NpOn.Tracker.Proto" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Contract\NpOn.TrackerServiceCommand\NpOn.TrackerServiceCommand.csproj" />
      <ProjectReference Include="..\..\Contract\NpOn.TrackerServiceDomain\NpOn.TrackerServiceDomain.csproj" />
      <ProjectReference Include="..\..\Definitions\NpOn.TrackerConstant\NpOn.TrackerConstant.csproj" />
      <ProjectReference Include="..\..\StorageAdapter\NpOn.ITrackerStorageAdapter\NpOn.ITrackerStorageAdapter.csproj" />
      <ProjectReference Include="..\..\StorageAdapter\NpOn.TrackerStorageAdapter\NpOn.TrackerStorageAdapter.csproj" />
      <ProjectReference Include="..\NpOn.ITrackerService\NpOn.ITrackerService.csproj" />
      <ProjectReference Include="..\NpOn.Tracker2WayService\NpOn.Tracker2WayService.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="appsettings.yaml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="SqlScripts\**\*.sql">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
