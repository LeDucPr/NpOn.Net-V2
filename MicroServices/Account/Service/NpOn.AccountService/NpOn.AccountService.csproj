<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RollForward>LatestMajor</RollForward>
        <RuntimeFrameworkVersion>10.0.0-preview.7.25380.108</RuntimeFrameworkVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>MicroServices.Account.Service.NpOn.AccountService</RootNamespace>

        <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
        <ContainerImageName>npon-v2-aiot-backend-accountservice</ContainerImageName>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-preview-noble-chiseled</ContainerBaseImage>
        <ContainerImageTag>latest</ContainerImageTag>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NpOn.Account.Proto"/>
        <PackageReference Include="NpOn.Tracker.Proto"/>
        <PackageReference Include="Riok.Mapperly"/>
        <PackageReference Include="NpOn.AddGrpcAppExtUse"/>
        <PackageReference Include="NpOn.KafkaAppExtUse"/>
        <PackageReference Include="NpOn.PostgresAppExtUse"/>
        <PackageReference Include="NpOn.RabbitMqAppExtUse"/>
        <PackageReference Include="NpOn.ZeroMqAppExtUse"/>
        <PackageReference Include="NpOn.ZeroMqExtCm"/>
        <PackageReference Include="NpOn.CommonHttpApplication"/>
        <PackageReference Include="NpOn.CommonBaseDomain"/>
        <PackageReference Include="NpOn.CommonEnums"/>
        <PackageReference Include="NpOn.CommonMode"/>
        <PackageReference Include="NpOn.CommonScope"/>
        <PackageReference Include="NpOn.HandleFlow"/>
        <PackageReference Include="NpOn.KafkaExtCm"/>
        <PackageReference Include="NpOn.RabbitMqExtMs"/>
        <PackageReference Include="NpOn.Tracker2WayService"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Contract\NpOn.AccountServiceDomain\NpOn.AccountServiceDomain.csproj" />
        <ProjectReference Include="..\..\Definitions\NpOn.AccountEnum\NpOn.AccountEnum.csproj"/>
        <ProjectReference Include="..\..\Definitions\NpOn.ShareAccountConstant\NpOn.ShareAccountConstant.csproj"/>
        <ProjectReference Include="..\..\StorageAdapter\NpOn.AccountStorageAdapter\NpOn.AccountStorageAdapter.csproj"/>
        <ProjectReference Include="..\..\StorageAdapter\NpOn.IAccountStorageAdapter\NpOn.IAccountStorageAdapter.csproj"/>
        <ProjectReference Include="..\NpOn.IAccountService\NpOn.IAccountService.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\..\.dockerignore">
          <Link>.dockerignore</Link>
        </Content>
        <Content Include="appsettings.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>


</Project>
