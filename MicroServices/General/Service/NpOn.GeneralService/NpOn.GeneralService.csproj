<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RollForward>LatestMajor</RollForward>
        <RuntimeFrameworkVersion>10.0.0-preview.7.25380.108</RuntimeFrameworkVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>MicroServices.General.Service.NpOn.GeneralService</RootNamespace>

        <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
        <ContainerImageName>npon-v2-aiot-backend-generalservice</ContainerImageName>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-preview-noble-chiseled</ContainerBaseImage>
        <ContainerImageTag>latest</ContainerImageTag>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NpOn.General.Proto"/>
        <PackageReference Include="Riok.Mapperly"/>
        <PackageReference Include="NpOn.AddGrpcAppExtUse"/>
        <PackageReference Include="NpOn.PostgresAppExtUse"/>
        <PackageReference Include="NpOn.CommonHttpApplication"/>
        <PackageReference Include="NpOn.CommonBaseDomain"/>
        <PackageReference Include="NpOn.CommonDb"/>
        <PackageReference Include="NpOn.CommonEnums"/>
        <PackageReference Include="NpOn.CommonGrpcContract"/>
        <PackageReference Include="NpOn.CommonMode"/>
        <PackageReference Include="NpOn.HandleFlow"/>
        <PackageReference Include="NpOn.ICommonDb"/>
        <PackageReference Include="MySqlConnector"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Contract\NpOn.GeneralServiceCommand\NpOn.GeneralServiceCommand.csproj" />
        <ProjectReference Include="..\..\Contract\NpOn.GeneralServiceReadModel\NpOn.GeneralServiceReadModel.csproj" />
        <ProjectReference Include="..\..\Definitions\NpOn.GeneralConstant\NpOn.GeneralConstant.csproj"/>
        <ProjectReference Include="..\NpOn.IGeneralService\NpOn.IGeneralService.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\..\.dockerignore">
          <Link>.dockerignore</Link>
        </Content>
        <Content Include="appsettings.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>