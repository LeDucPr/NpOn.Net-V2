<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RollForward>LatestMajor</RollForward>
        <RuntimeFrameworkVersion>10.0.0-preview.7.25380.108</RuntimeFrameworkVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Controllers.NpOn.SSO</RootNamespace>

        <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
        <ContainerImageName>npon-v2-aiot-backend-sso</ContainerImageName>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-preview-noble-chiseled</ContainerBaseImage>
        <ContainerImageTag>latest</ContainerImageTag>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="FluentValidation"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="protobuf-net.Grpc.Reflection"/>
        <PackageReference Include="NpOn.AddGrpcAppExtUse" />
        <PackageReference Include="NpOn.TokenValidatorExtUse" />
        <PackageReference Include="NpOn.CommonHttpApplication" />
        <PackageReference Include="NpOn.CommonEnums" />
        <PackageReference Include="NpOn.CommonGrpcContract" />
        <PackageReference Include="NpOn.CommonInternalCache" />
        <PackageReference Include="NpOn.CommonMode" />
        <PackageReference Include="NpOn.Account.Proto" />
        <PackageReference Include="NpOn.Sso.Proto" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\.dockerignore">
          <Link>.dockerignore</Link>
        </Content>
        <Content Include="appsettings.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
